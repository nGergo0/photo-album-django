apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: photo-album
  namespace: ${namespace}
spec:
  to:
    kind: Service
    name: photo-album-django
    weight: 100
  port:
    targetPort: 8000-tcp
  tls:
    termination: edge
    insecureEdgeTerminationPolicy: Redirect
  wildcardPolicy: None
