apiVersion: apps/v1
kind: Deployment
metadata:
  name: photo-album-django
  namespace: ${namespace}
  annotations:
    alpha.image.policy.openshift.io/resolve-names: "*"
    image.openshift.io/triggers: >-
      [{"from":{"kind":"ImageStreamTag","name":"photo-album-django:latest","namespace":"${namespace}"},"fieldPath":"spec.template.spec.containers[?(@.name==\"photo-album-django\")].image","paused":false}]
spec:
  replicas: 2
  selector:
    matchLabels:
      app: photo-album-django
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0%
      maxSurge: 25%
  template:
    metadata:
      labels:
        app: photo-album-django
        deployment: photo-album-django
    spec:
      volumes:
        - name: media-data
          persistentVolumeClaim:
            claimName: photo-album-pvc-rwx
      containers:
        - name: photo-album-django
          image: photo-album-django:latest
          imagePullPolicy: Always
          ports:
            - containerPort: 8000
              protocol: TCP
          env:
            - name: USE_S3
              value: "False"
            - name: DB_ENGINE
              value: postgres
            - name: DB_NAME
              valueFrom:
                secretKeyRef:
                  name: db-postgres
                  key: database-name
            - name: DB_USER
              valueFrom:
                secretKeyRef:
                  name: db-postgres
                  key: database-user
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: db-postgres
                  key: database-password
            - name: DB_HOST
              value: db-postgres
            - name: DB_PORT
              value: "5432"
            - name: DEBUG
              value: "true"
          resources:
            limits:
              cpu: 1600m
              memory: 2Gi
            requests:
              cpu: 400m
              memory: 512Mi
          startupProbe:
            httpGet:
              path: /api/health/ready/
              port: 8000
              scheme: HTTP
            timeoutSeconds: 2
            periodSeconds: 5
            failureThreshold: 24
          readinessProbe:
            httpGet:
              path: /api/health/ready/
              port: 8000
              scheme: HTTP
            initialDelaySeconds: 10
            timeoutSeconds: 3
            periodSeconds: 10
            failureThreshold: 6
          volumeMounts:
            - name: media-data
              mountPath: /data/media
